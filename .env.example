# ---------- база ----------
# Supabase → Project Settings → Database → Connection pooling → Transaction (порт 6543).
# Именно pooler, а не прямое подключение: на Vercel каждый запрос — своя функция,
# и прямые соединения кончатся раньше, чем трафик.
DATABASE_URL=postgresql://postgres.xxxxxxxx:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------- бот ----------
# Токен от @BotFather. Без него сайт работает целиком, кроме входа
# через Telegram Mini App. С ним вебхук регистрируется сам при деплое.
BOT_TOKEN=

# Секрет заголовка X-Telegram-Bot-Api-Secret-Token.
# Можно не задавать: тогда он детерминированно выводится из BOT_TOKEN.
TELEGRAM_WEBHOOK_SECRET=

# ---------- владелец сайта и консоль /admin ----------
# Куда бот шлёт алерты об ошибках и входах в консоль: свой Telegram id
# (напиши боту /id в личке) или id рабочей группы. Свой id здесь же делает
# тебя владельцем.
ALERT_CHAT_ID=
# Ещё владельцы через запятую — если ALERT_CHAT_ID указывает на группу.
OWNER_IDS=
# Ключ HMAC для кодов входа в консоль и хешей адресов в её журнале.
# Можно не задавать: тогда выводится из BOT_TOKEN.
OWNER_CONSOLE_SECRET=

# ---------- адрес сайта ----------
# На Vercel определяется сам. Задай явно, если домен свой
# или если гоняешь бота локально через туннель.
NEXT_PUBLIC_SITE_URL=

# ---------- прочее ----------
# Пустое значение — то же, что не заданное: берётся значение по умолчанию.
# Пояс консоли владельца /admin. Сайт и бот живут в поясе группы.
DEFAULT_TZ=Asia/Almaty

# Секрет адреса /api/cron/reminders: тот же — в Vercel, в секретах GitHub
# Actions и в заголовке `Authorization: Bearer …` у пингера cron-job.org
# (DEPLOY.md, шаг 6). Cron Vercel подставляет его сам.
CRON_SECRET=

# ---------- мониторинг ----------
# Пульс cron для healthchecks.io: после каждого прогона напоминаний сайт
# стучится сюда (после упавшего — на <адрес>/fail). Только https.
# Пусто — пульса нет (DEPLOY.md, «Мониторинг»).
HEALTHCHECKS_PING_URL=
