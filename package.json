{
  "name": "qairu-cowork",
  "version": "3.0.0",
  "private": true,
  "description": "Finds shared free windows for a student group. Website + Telegram bot on Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-schema.mjs && next build && node scripts/set-webhook.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "bot:webhook": "node scripts/set-webhook.mjs --force",
    "db:check": "node scripts/check-schema.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "postgres": "^3.4.7",
    "qrcode-generator": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
